{
  "name": "agentgrid-execution",
  "main": "worker.ts",
  "compatibility_date": "2026-10-09",
  "vars": {
    "AGENTGRID_EXECUTION_ENABLED": "0",
    "AGENTGRID_REEL_GENERATION_ENABLED": "0",
    "AGENTGRID_SOCIAL_PUBLISHING_ENABLED": "0",
    "AGENTGRID_SOCIAL_OAUTH_ENABLED": "0",
    "AGENTGRID_SOCIAL_SCHEDULER_ENABLED": "0",
    "AGENTGRID_STAGE": "production",
    "AGENTGRID_ORIGIN": "https://agentgrid.me",
  },
  "triggers": { "crons": ["* * * * *"] },
  "queues": {
    "producers": [{ "binding": "AGENTGRID_EXECUTION_QUEUE", "queue": "agentgrid-execution" }],
    "consumers": [
      {
        "queue": "agentgrid-execution",
        "max_batch_size": 1,
        "max_retries": 3,
        "dead_letter_queue": "agentgrid-execution-dead",
      },
    ],
  },
}
