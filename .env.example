# Public Supabase values: safe in browser bundles; authorization is enforced by RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Local/CI backend configuration. Never prefix privileged values with NEXT_PUBLIC_.
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=
SUPABASE_SECRET_KEY=

# Deployment credentials: scope token to the AgentGrid Pages project/account.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Configure SMTP in Supabase. Never expose SMTP credentials to application users.
RESEND_API_KEY=

