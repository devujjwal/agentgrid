# Public Supabase values: safe in browser bundles; authorization is enforced by RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Local/CI backend configuration. Never prefix privileged values with NEXT_PUBLIC_.
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=
SUPABASE_SECRET_KEY=

# Deployment credentials: scope token to the AgentGrid Pages project/account.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# AgentGrid-only sending credential for its server-side email adapter.
# Do not change shared Supabase SMTP/templates or reuse other applications' keys.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Provider setup only: these are never required in the browser or static export.
# Supabase stores the Google client secret; keep the local setup copy private.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Server-only live identity boundary. Never include these values in static builds.
# Allowed origins are stage-specific; preview/development require an owner pilot.
AGENTGRID_STAGE=
AGENTGRID_ORIGIN=
AGENTGRID_PILOT_EMAILS=
# JSON array: active key first; at most one retained key for deliberate rotation.
# Each material is canonical base64url for 32 independently random bytes.
AGENTGRID_ENVELOPE_KEYS=
AGENTGRID_RATE_KEY=

# Optional aggregate analytics. Both gates default off. Enable only after the
# privacy notice, retention operations and staging acceptance are complete.
NEXT_PUBLIC_AGENTGRID_ANALYTICS=0
AGENTGRID_ANALYTICS_ENABLED=0
